@@ -0,0 +1,68 @@
+from __future__ import annotations
+
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+import context_engine as ce
+import lab_tools_project as ltp
+
+
+class BoundedProjectReadTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.workspace = Path(tempfile.mkdtemp(prefix="hsp346_arm_a_", dir=str(Path(__file__).resolve().parents[2])))
+        self.root = self.workspace / "project"
+        self.root.mkdir()
+        (self.root / "sample.txt").write_text("alpha\nbéta\ngamma\n", encoding="utf-8")
+        (self.root / "utf8.txt").write_text("ééé", encoding="utf-8")
+        (self.workspace / "outside.txt").write_text("outside", encoding="utf-8")
+        self._old_get_allowed_roots = ce.get_allowed_roots
+        ce.get_allowed_roots = lambda: [self.workspace.resolve()]
+
+    def tearDown(self) -> None:
+        ce.get_allowed_roots = self._old_get_allowed_roots
+        shutil.rmtree(self.workspace, ignore_errors=True)
+
+    def test_range_is_1_based_inclusive(self) -> None:
+        result = ce.read_file(ce.FileReadRequest(path="sample.txt", base_root=str(self.root), start_line=2, end_line=2, max_bytes=100))
+        self.assertEqual("béta", result.content)
+        self.assertEqual((2, 2), (result.slice.start_line, result.slice.end_line))
+
+    def test_utf8_budget_never_splits_or_exceeds(self) -> None:
+        for budget in range(0, 7):
+            request_budget = budget if budget else 0
+            result = ce.read_file(ce.FileReadRequest(path="utf8.txt", base_root=str(self.root), max_bytes=request_budget))
+            if budget:
+                self.assertLessEqual(len(result.content.encode("utf-8")), budget)
+                result.content.encode("utf-8").decode("utf-8")
+        self.assertEqual("é", ce.read_file(ce.FileReadRequest(path="utf8.txt", base_root=str(self.root), max_bytes=3)).content)
+
+    def test_base_root_confines_relative_and_absolute_paths(self) -> None:
+        for path in ("../outside.txt", str((self.workspace / "outside.txt").resolve())):
+            with self.assertRaises(ce.BadPathError):
+                ce.read_file(ce.FileReadRequest(path=path, base_root=str(self.root), max_bytes=100))
+
+    def test_parent_project_files_read_surface(self) -> None:
+        dep = SimpleNamespace(
+            normalize_project_path=lambda payload: str(payload.get("path", "")),
+            project_root_path=lambda project_id: str(self.root),
+            context_wrap=lambda thunk: thunk(),
+            read_file=ce.read_file,
+        )
+        result = ltp._project_files_read_payload({"project_id":"A", "path":"sample.txt", "start_line":2, "end_line":2, "max_bytes":100}, dep)
+        data = result.to_dict() if hasattr(result, "to_dict") else result
+        self.assertEqual("béta", data["content"])
+
+    def test_read_many_preserves_missing_child_failure(self) -> None:
+        dep = SimpleNamespace(error_cls=RuntimeError, get_project_root=lambda project_id:self.root, read_file=ce.read_file)
+        result = ltp._project_read_many_payload({"project_id":"A", "paths":["sample.txt","missing.txt"], "max_bytes_each":5}, dep)
+        self.assertEqual(1, result["read_count"])
+        self.assertEqual(1, result["error_count"])
+        self.assertNotIn("error", result["files"]["sample.txt"])
+        self.assertIn("error", result["files"]["missing.txt"])
+
+
+if __name__ == "__main__":
+    unittest.main()
