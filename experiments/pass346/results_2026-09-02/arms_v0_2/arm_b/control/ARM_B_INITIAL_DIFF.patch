--- /dev/null
+++ b/tests/test_hsp_bounded_read_contract.py
@@ -0,0 +1,90 @@
+from __future__ import annotations
+
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+import context_engine as ce
+import lab_tools_project as ltp
+
+
+class HspBoundedReadContractTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.workspace = Path(tempfile.mkdtemp(prefix="hsp346_arm_b_", dir=str(Path(__file__).resolve().parents[2])))
+        self.root = self.workspace / "project"
+        self.root.mkdir()
+        (self.root / "sample.txt").write_text("alpha\nbéta\ngamma\n", encoding="utf-8")
+        (self.root / "utf8.txt").write_text("ééé", encoding="utf-8")
+        (self.root / "blob.bin").write_bytes(b"abc")
+        (self.workspace / "outside.txt").write_text("outside", encoding="utf-8")
+        self.old_roots = ce.get_allowed_roots
+        ce.get_allowed_roots = lambda: [self.workspace.resolve()]
+
+    def tearDown(self) -> None:
+        ce.get_allowed_roots = self.old_roots
+        shutil.rmtree(self.workspace, ignore_errors=True)
+
+    def test_line_window_is_exactly_1_based_inclusive(self) -> None:
+        r = ce.read_file(ce.FileReadRequest(path="sample.txt", base_root=str(self.root), start_line=2, end_line=2, max_bytes=100))
+        self.assertTrue(r.ok)
+        self.assertEqual("béta", r.content)
+        self.assertEqual((2, 2), (r.slice.start_line, r.slice.end_line))
+
+    def test_utf8_ceiling_holds_at_multibyte_boundaries(self) -> None:
+        expected = {1:"", 2:"é", 3:"é", 4:"éé", 5:"éé", 6:"ééé"}
+        for budget, content in expected.items():
+            with self.subTest(budget=budget):
+                r = ce.read_file(ce.FileReadRequest(path="utf8.txt", base_root=str(self.root), max_bytes=budget))
+                self.assertEqual(content, r.content)
+                self.assertLessEqual(len(r.content.encode("utf-8")), budget)
+
+    def test_full_read_control_preserves_content(self) -> None:
+        r = ce.read_file(ce.FileReadRequest(path="sample.txt", base_root=str(self.root), max_bytes=1000))
+        self.assertEqual("alpha\nbéta\ngamma\n", r.content)
+
+    def test_exact_project_root_is_authority_boundary(self) -> None:
+        for path in ("../outside.txt", str((self.workspace / "outside.txt").resolve())):
+            with self.subTest(path=path), self.assertRaises(ce.BadPathError):
+                ce.read_file(ce.FileReadRequest(path=path, base_root=str(self.root), max_bytes=100))
+
+    def test_parent_single_read_requalifies_core_result(self) -> None:
+        dep = SimpleNamespace(
+            normalize_project_path=lambda payload: str(payload.get("path", "")),
+            project_root_path=lambda project_id: str(self.root),
+            context_wrap=lambda thunk: thunk(),
+            read_file=ce.read_file,
+        )
+        r = ltp._project_files_read_payload({"project_id":"B", "path":"sample.txt", "start_line":2, "end_line":2, "max_bytes":100}, dep)
+        data = r.to_dict() if hasattr(r, "to_dict") else r
+        self.assertTrue(data["ok"])
+        self.assertEqual("béta", data["content"])
+
+    def test_read_many_preserves_failure_and_truthful_success_metadata(self) -> None:
+        dep = SimpleNamespace(error_cls=RuntimeError, get_project_root=lambda project_id:self.root, read_file=ce.read_file)
+        r = ltp._project_read_many_payload({"project_id":"B", "paths":["sample.txt","missing.txt"], "max_bytes_each":5}, dep)
+        self.assertEqual((1,1), (r["read_count"], r["error_count"]))
+        good = r["files"]["sample.txt"]
+        bad = r["files"]["missing.txt"]
+        self.assertEqual("alpha", good["content"])
+        self.assertEqual(5, good["size_bytes"])
+        self.assertTrue(good["truncated"])
+        self.assertIn("error", bad)
+
+    def test_unsupported_nontext_path_is_rejected(self) -> None:
+        with self.assertRaises(ce.BadPathError):
+            ce.read_file(ce.FileReadRequest(path="blob.bin", base_root=str(self.root), max_bytes=100))
+
+    def test_eof_range_is_bounded_and_nonexceptional(self) -> None:
+        r = ce.read_file(ce.FileReadRequest(path="sample.txt", base_root=str(self.root), start_line=99, end_line=120, max_bytes=100))
+        self.assertEqual("", r.content)
+        self.assertEqual(99, r.slice.start_line)
+
+    def test_invalid_negative_budget_is_not_laundered_into_success(self) -> None:
+        with self.assertRaises(ValueError):
+            ce.read_file(ce.FileReadRequest(path="sample.txt", base_root=str(self.root), max_bytes=-2))
+
+
+if __name__ == "__main__":
+    unittest.main()
