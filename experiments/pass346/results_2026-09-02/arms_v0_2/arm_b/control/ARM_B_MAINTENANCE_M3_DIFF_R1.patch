+    def test_tail_lines_selects_final_logical_lines_then_applies_byte_ceiling(self) -> None:
+        full = ce.read_file(ce.FileReadRequest(path="sample.txt", base_root=str(self.root), tail_lines=2, max_bytes=100))
+        self.assertEqual("béta\ngamma", full.content)
+        self.assertEqual((2, 3), (full.slice.start_line, full.slice.end_line))
+        bounded = ce.read_file(ce.FileReadRequest(path="sample.txt", base_root=str(self.root), tail_lines=2, max_bytes=8))
+        self.assertEqual("béta\nga", bounded.content)
+        self.assertLessEqual(len(bounded.content.encode("utf-8")), 8)
+
+    def test_tail_lines_is_exclusive_with_explicit_window(self) -> None:
+        with self.assertRaises(ValueError):
+            ce.read_file(ce.FileReadRequest(path="sample.txt", base_root=str(self.root), start_line=1, tail_lines=2, max_bytes=100))
+
+    def test_tail_lines_parent_lab_surface_requalifies_mode(self) -> None:
+        dep = SimpleNamespace(
+            normalize_project_path=lambda payload: str(payload.get("path", "")),
+            project_root_path=lambda project_id: str(self.root),
+            context_wrap=lambda thunk: thunk(),
+            read_file=ce.read_file,
+        )
+        r = ltp._project_files_read_payload({"project_id":"B", "path":"sample.txt", "tail_lines":2, "max_bytes":100}, dep)
+        data = r.to_dict() if hasattr(r, "to_dict") else r
+        self.assertEqual("béta\ngamma", data["content"])
+        self.assertEqual((2, 3), (data["slice"]["start_line"], data["slice"]["end_line"]))
+
+    def test_tail_lines_wire_and_imported_schema_exposure(self) -> None:
+        req = awc.ProjectFilesReadRequest.from_json({"project_id":"B", "path":"sample.txt", "tail_lines":2, "max_bytes":100})
+        self.assertEqual(2, req.tail_lines)
+        target_root = Path(__file__).resolve().parents[1]
+        import json
+        for name in ("pcmmad_lab_action_schema_v10_3_pcmmad_native_protocol_compact_30_router.json", "pcmmad_lab_action_schema_ACTIVE.json"):
+            schema = json.loads((target_root / name).read_text(encoding="utf-8-sig"))
+            prop = schema["components"]["schemas"]["ProjectFilesReadRequest"]["properties"]["tail_lines"]
+            self.assertEqual("integer", prop["type"])
+            self.assertEqual(1, prop["minimum"])
+            self.assertFalse(schema["components"]["schemas"]["ProjectFilesReadRequest"]["additionalProperties"])
