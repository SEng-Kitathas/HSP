+def validated_read_result_evidence(result: object) -> tuple[str, int, bool]:
+    """Return child content/returned-bytes/truncation only from consistent core evidence."""
+
+    as_dict = result.to_dict() if hasattr(result, "to_dict") else result
+    if not isinstance(as_dict, dict):
+        raise ValueError("read child result must be an object")
+    content = as_dict.get("content")
+    if not isinstance(content, str):
+        raise ValueError("read child content evidence is invalid")
+    slice_data = as_dict.get("slice")
+    if not isinstance(slice_data, dict):
+        raise ValueError("read child result is missing slice evidence")
+
+    selected_bytes = slice_data.get("selected_bytes")
+    returned_bytes = slice_data.get("returned_bytes")
+    truncated = slice_data.get("truncated")
+    if isinstance(selected_bytes, bool) or not isinstance(selected_bytes, int) or selected_bytes < 0:
+        raise ValueError("read child selected_bytes evidence is invalid")
+    if isinstance(returned_bytes, bool) or not isinstance(returned_bytes, int) or returned_bytes < 0:
+        raise ValueError("read child returned_bytes evidence is invalid")
+    if not isinstance(truncated, bool):
+        raise ValueError("read child truncated evidence is invalid")
+
+    actual_returned_bytes = len(content.encode("utf-8"))
+    if returned_bytes != actual_returned_bytes:
+        raise ValueError("read child returned_bytes does not match content")
+    if selected_bytes < returned_bytes:
+        raise ValueError("read child selected_bytes is smaller than returned_bytes")
+    if truncated != (returned_bytes < selected_bytes):
+        raise ValueError("read child truncated evidence is inconsistent")
+    return content, returned_bytes, truncated
+
+
